# ── Secrets ──────────────────────────────────────────────────────────────
# Never commit real API keys. Keep a redacted .env.example for onboarding.
.env
.env.*
!.env.example

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Virtual environments ──────────────────────────────────────────────────
.venv/
venv/
env/

# ── OBSCURA runtime artifacts (regenerated at runtime) ────────────────────
logs/
investigations/*.db
investigations/*.db-shm
investigations/*.db-wal
investigations/backup.db
investigations/crawled/

# ── OS / editor cruft ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
