# OBSCURA .env — copy to `.env` and fill in the values you need.
# Anything left commented or set to a `your_*` placeholder is treated as
# "not configured" and that provider stays hidden from the UI.
#
#   cp .env.example .env

# ─── Cloud LLM providers ────────────────────────────────────────────────────
# Set a key for any provider you want exposed in the model picker. OBSCURA runs
# fine with just one. You can also use OpenRouter (below) to reach many models
# behind a single key.
# OPENAI_API_KEY=your_openai_key
# ANTHROPIC_API_KEY=your_anthropic_key
# GOOGLE_API_KEY=your_google_key

# ─── OpenRouter ─────────────────────────────────────────────────────────────
# One key → many models (GPT, Claude, Gemini, Grok, Qwen, …).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=your_openrouter_key

# ─── Local LLMs ─────────────────────────────────────────────────────────────
# Ollama: serve at this URL and OBSCURA auto-lists pulled models.
# For Docker → host, use http://host.docker.internal:11434/
# OLLAMA_BASE_URL=http://localhost:11434
# llama.cpp's OpenAI-compatible server (--server):
# LLAMA_CPP_BASE_URL=http://localhost:8080

# ─── Tor ────────────────────────────────────────────────────────────────────
# Ports are auto-probed (9150/9050 SOCKS, 9151/9051 control); override only if
# your Tor uses non-standard ports. A control port + (optional) password is
# required for the "New Tor Identity" button (SIGNAL NEWNYM).
# TOR_SOCKS_PORT=9150
# TOR_CONTROL_PORT=9051
# TOR_CONTROL_PASSWORD=your_control_password
# Path to the Tor Browser Firefox binary for the Selenium deep-crawl tier
# (falls back to a stock Firefox over Tor SOCKS if unset):
# TORBROWSER_BINARY=/path/to/tor-browser/Browser/firefox

# ─── Server ─────────────────────────────────────────────────────────────────
# Native runs bind localhost by default (no auth). Set 0.0.0.0 only if you
# intentionally want LAN exposure. The Docker image sets 0.0.0.0 itself.
# OBSCURA_HOST=127.0.0.1
# OBSCURA_PORT=8501
